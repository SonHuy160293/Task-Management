# syntax=docker/dockerfile:1
ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
ARG DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0@sha256:de0ee358cdd672f7017a003bed21e9ac9ed48a27c922a59b18175b6e82fa7fee
FROM ${DOTNET_SDK_IMAGE} AS restore
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/Gateway/DevFlow.Gateway/DevFlow.Gateway.csproj src/Gateway/DevFlow.Gateway/
COPY src/BuildingBlocks/DevFlow.AspNetCore/DevFlow.AspNetCore.csproj src/BuildingBlocks/DevFlow.AspNetCore/
COPY src/BuildingBlocks/DevFlow.EntityFrameworkCore/DevFlow.EntityFrameworkCore.csproj src/BuildingBlocks/DevFlow.EntityFrameworkCore/
COPY src/BuildingBlocks/DevFlow.Messaging/DevFlow.Messaging.csproj src/BuildingBlocks/DevFlow.Messaging/
COPY src/BuildingBlocks/DevFlow.Observability/DevFlow.Observability.csproj src/BuildingBlocks/DevFlow.Observability/
COPY src/BuildingBlocks/DevFlow.SharedKernel/DevFlow.SharedKernel.csproj src/BuildingBlocks/DevFlow.SharedKernel/
COPY src/BuildingBlocks/DevFlow.Utilities/DevFlow.Utilities.csproj src/BuildingBlocks/DevFlow.Utilities/
COPY src/Contracts/DevFlow.Identity.Contracts/DevFlow.Identity.Contracts.csproj src/Contracts/DevFlow.Identity.Contracts/
COPY src/Contracts/DevFlow.Notification.Contracts/DevFlow.Notification.Contracts.csproj src/Contracts/DevFlow.Notification.Contracts/
COPY src/Modules/DevFlow.Identity/DevFlow.Identity.API/DevFlow.Identity.API.csproj src/Modules/DevFlow.Identity/DevFlow.Identity.API/
COPY src/Modules/DevFlow.Identity/DevFlow.Identity.Application/DevFlow.Identity.Application.csproj src/Modules/DevFlow.Identity/DevFlow.Identity.Application/
COPY src/Modules/DevFlow.Identity/DevFlow.Identity.Domain/DevFlow.Identity.Domain.csproj src/Modules/DevFlow.Identity/DevFlow.Identity.Domain/
COPY src/Modules/DevFlow.Identity/DevFlow.Identity.Infrastructure/DevFlow.Identity.Infrastructure.csproj src/Modules/DevFlow.Identity/DevFlow.Identity.Infrastructure/
COPY src/Modules/DevFlow.Identity/DevFlow.Identity.MigrationRunner/DevFlow.Identity.MigrationRunner.csproj src/Modules/DevFlow.Identity/DevFlow.Identity.MigrationRunner/
COPY src/Modules/DevFlow.Identity/DevFlow.Identity.Worker/DevFlow.Identity.Worker.csproj src/Modules/DevFlow.Identity/DevFlow.Identity.Worker/
COPY src/Modules/DevFlow.Notification/DevFlow.Notification.API/DevFlow.Notification.API.csproj src/Modules/DevFlow.Notification/DevFlow.Notification.API/
COPY src/Modules/DevFlow.Notification/DevFlow.Notification.Application/DevFlow.Notification.Application.csproj src/Modules/DevFlow.Notification/DevFlow.Notification.Application/
COPY src/Modules/DevFlow.Notification/DevFlow.Notification.Domain/DevFlow.Notification.Domain.csproj src/Modules/DevFlow.Notification/DevFlow.Notification.Domain/
COPY src/Modules/DevFlow.Notification/DevFlow.Notification.Infrastructure/DevFlow.Notification.Infrastructure.csproj src/Modules/DevFlow.Notification/DevFlow.Notification.Infrastructure/
COPY src/Modules/DevFlow.Notification/DevFlow.Notification.MigrationRunner/DevFlow.Notification.MigrationRunner.csproj src/Modules/DevFlow.Notification/DevFlow.Notification.MigrationRunner/
COPY src/Modules/DevFlow.Notification/DevFlow.Notification.Worker/DevFlow.Notification.Worker.csproj src/Modules/DevFlow.Notification/DevFlow.Notification.Worker/
COPY src/Modules/DevFlow.Tasks/DevFlow.Tasks.API/DevFlow.Tasks.API.csproj src/Modules/DevFlow.Tasks/DevFlow.Tasks.API/
COPY src/Modules/DevFlow.Tasks/DevFlow.Tasks.Application/DevFlow.Tasks.Application.csproj src/Modules/DevFlow.Tasks/DevFlow.Tasks.Application/
COPY src/Modules/DevFlow.Tasks/DevFlow.Tasks.Domain/DevFlow.Tasks.Domain.csproj src/Modules/DevFlow.Tasks/DevFlow.Tasks.Domain/
COPY src/Modules/DevFlow.Tasks/DevFlow.Tasks.Infrastructure/DevFlow.Tasks.Infrastructure.csproj src/Modules/DevFlow.Tasks/DevFlow.Tasks.Infrastructure/
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet restore src/Modules/DevFlow.Identity/DevFlow.Identity.API/DevFlow.Identity.API.csproj --disable-parallel
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet restore src/Modules/DevFlow.Identity/DevFlow.Identity.Worker/DevFlow.Identity.Worker.csproj --disable-parallel
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet restore src/Modules/DevFlow.Identity/DevFlow.Identity.MigrationRunner/DevFlow.Identity.MigrationRunner.csproj --disable-parallel
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet restore src/Modules/DevFlow.Notification/DevFlow.Notification.API/DevFlow.Notification.API.csproj --disable-parallel
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet restore src/Modules/DevFlow.Notification/DevFlow.Notification.Worker/DevFlow.Notification.Worker.csproj --disable-parallel
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet restore src/Modules/DevFlow.Notification/DevFlow.Notification.MigrationRunner/DevFlow.Notification.MigrationRunner.csproj --disable-parallel
FROM restore AS source
COPY src/ src/

FROM source AS identity-api-build
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet publish src/Modules/DevFlow.Identity/DevFlow.Identity.API/DevFlow.Identity.API.csproj -c Release -o /out --no-restore -m:1 -nr:false /p:UseAppHost=false /p:UseSharedCompilation=false

FROM source AS gateway-build
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet publish src/Gateway/DevFlow.Gateway/DevFlow.Gateway.csproj -c Release -o /out -m:1 -nr:false /p:UseAppHost=false /p:UseSharedCompilation=false

FROM source AS identity-worker-build
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet publish src/Modules/DevFlow.Identity/DevFlow.Identity.Worker/DevFlow.Identity.Worker.csproj -c Release -o /out --no-restore -m:1 -nr:false /p:UseAppHost=false /p:UseSharedCompilation=false

FROM source AS identity-migration-build
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet publish src/Modules/DevFlow.Identity/DevFlow.Identity.MigrationRunner/DevFlow.Identity.MigrationRunner.csproj -c Release -o /out --no-restore -m:1 -nr:false /p:UseAppHost=false /p:UseSharedCompilation=false

FROM source AS notification-api-build
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet publish src/Modules/DevFlow.Notification/DevFlow.Notification.API/DevFlow.Notification.API.csproj -c Release -o /out --no-restore -m:1 -nr:false /p:UseAppHost=false /p:UseSharedCompilation=false

FROM source AS notification-worker-build
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet publish src/Modules/DevFlow.Notification/DevFlow.Notification.Worker/DevFlow.Notification.Worker.csproj -c Release -o /out --no-restore -m:1 -nr:false /p:UseAppHost=false /p:UseSharedCompilation=false

FROM source AS notification-migration-build
RUN --mount=type=cache,id=devflow-nuget,target=/root/.nuget/packages dotnet publish src/Modules/DevFlow.Notification/DevFlow.Notification.MigrationRunner/DevFlow.Notification.MigrationRunner.csproj -c Release -o /out --no-restore -m:1 -nr:false /p:UseAppHost=false /p:UseSharedCompilation=false

FROM ${DOTNET_RUNTIME_IMAGE} AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl libgssapi-krb5-2 && rm -rf /var/lib/apt/lists/*
COPY deploy/setup/worker-health.sh /opt/devflow/worker-health.sh
RUN chmod 755 /opt/devflow/worker-health.sh
ENV ASPNETCORE_HTTP_PORTS=8080
USER $APP_UID

FROM runtime AS identity-api
COPY --from=identity-api-build /out .
ENTRYPOINT ["dotnet", "DevFlow.Identity.API.dll"]

FROM runtime AS gateway
COPY --from=gateway-build /out .
ENTRYPOINT ["dotnet", "DevFlow.Gateway.dll"]

FROM runtime AS identity-worker
COPY --from=identity-worker-build /out .
ENTRYPOINT ["dotnet", "DevFlow.Identity.Worker.dll"]

FROM runtime AS identity-migration
COPY --from=identity-migration-build /out .
ENTRYPOINT ["dotnet", "DevFlow.Identity.MigrationRunner.dll"]

FROM runtime AS notification-api
COPY --from=notification-api-build /out .
ENTRYPOINT ["dotnet", "DevFlow.Notification.API.dll"]

FROM runtime AS notification-worker
COPY --from=notification-worker-build /out .
ENTRYPOINT ["dotnet", "DevFlow.Notification.Worker.dll"]

FROM runtime AS notification-migration
COPY --from=notification-migration-build /out .
ENTRYPOINT ["dotnet", "DevFlow.Notification.MigrationRunner.dll"]
