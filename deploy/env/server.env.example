# Private single-Linux-host template. No builds, public ingress, or HA claim.
# Provision files using deploy/ENVIRONMENT.md; never place secret values here.
# Supply release tags/digests from your registry. Latest/local/dev tags are rejected.
DEVFLOW_STACK=devflow-server
DEVFLOW_ENVIRONMENT=Production
DEVFLOW_SECRETS_DIR=/etc/devflow/secrets
DEVFLOW_SETUP_IMAGE=registry.example/devflow/setup:REPLACE_WITH_RELEASE
DEVFLOW_GATEWAY_IMAGE=registry.example/devflow/gateway:REPLACE_WITH_RELEASE
DEVFLOW_GATEWAY_PORT=8080
DEVFLOW_GATEWAY_PUBLIC_HOST=REPLACE_WITH_PUBLIC_API_HOSTNAME
DEVFLOW_HTTP_SUBNET=172.30.250.0/24
DEVFLOW_GATEWAY_IP=172.30.250.10
DEVFLOW_INGRESS_PROXY_IP=REPLACE_WITH_OBSERVED_INGRESS_PEER_IPV4
DEVFLOW_IDENTITY_API_IMAGE=registry.example/devflow/identity-api:REPLACE_WITH_RELEASE
DEVFLOW_IDENTITY_WORKER_IMAGE=registry.example/devflow/identity-worker:REPLACE_WITH_RELEASE
DEVFLOW_IDENTITY_MIGRATION_IMAGE=registry.example/devflow/identity-migration:REPLACE_WITH_RELEASE
DEVFLOW_NOTIFICATION_API_IMAGE=registry.example/devflow/notification-api:REPLACE_WITH_RELEASE
DEVFLOW_NOTIFICATION_WORKER_IMAGE=registry.example/devflow/notification-worker:REPLACE_WITH_RELEASE
DEVFLOW_NOTIFICATION_MIGRATION_IMAGE=registry.example/devflow/notification-migration:REPLACE_WITH_RELEASE
DEVFLOW_DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
DEVFLOW_DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0@sha256:de0ee358cdd672f7017a003bed21e9ac9ed48a27c922a59b18175b6e82fa7fee
DEVFLOW_POSTGRES_IMAGE=postgres:18-bookworm@sha256:bbf83594798e144bff365a9c191c5d779f181fb3135902064ab8ff11918020fc
DEVFLOW_REDIS_IMAGE=redis:7.4-alpine@sha256:57e4255cc971b1c8d6f8a6ca283ac01bc3ecdd914273ef6bfaede87aaecd6541
DEVFLOW_RABBITMQ_IMAGE=rabbitmq:4.3.6-management@sha256:54cb013d76cd1fd6c0a0708f34062ad61c452bb6f016b434c6c33f1a765d2b58
DEVFLOW_MAILPIT_IMAGE=axllent/mailpit:v1.27@sha256:e22dce5b36f93c77082e204a3942fb6b283b7896e057458400a4c88344c3df68
# Backend ports below are local development settings; server APIs publish no ports.
DEVFLOW_IDENTITY_API_PORT=8081
DEVFLOW_NOTIFICATION_API_PORT=8082
# Developer-only values below are unused by the image-only module definitions.
DEVFLOW_IDENTITY_POSTGRES_PORT=15431
DEVFLOW_NOTIFICATION_POSTGRES_PORT=15432
DEVFLOW_REDIS_PORT=16379
DEVFLOW_RABBITMQ_AMQP_PORT=5672
DEVFLOW_RABBITMQ_MANAGEMENT_PORT=15672
DEVFLOW_MAILPIT_SMTP_PORT=11025
DEVFLOW_MAILPIT_HTTP_PORT=18025
DEVFLOW_FRONTEND_ORIGIN=https://REPLACE_WITH_FRONTEND_ORIGIN
DEVFLOW_JWT_ISSUER=DevFlow.Identity
DEVFLOW_JWT_AUDIENCE=DevFlow
# Operator-provided TLS RabbitMQ cluster, credentials, permissions and topology.
# The bundled single-node broker is local-only. Certificate must be trusted.
DEVFLOW_MESSAGING_HOST=REPLACE_WITH_TLS_BROKER_HOST
DEVFLOW_MESSAGING_PORT=5671
DEVFLOW_MESSAGING_VIRTUAL_HOST=/devflow-server
DEVFLOW_MESSAGING_DEVELOPMENT=false
DEVFLOW_MESSAGING_USE_TLS=true
DEVFLOW_MESSAGING_QUORUM_SIZE=3
DEVFLOW_EMAIL_MODE=Disabled
DEVFLOW_EMAIL_SENDER=DevFlow <auth@example.test>
DEVFLOW_EMAIL_DOMAIN_VERIFIED=false
DEVFLOW_GRAFANA_PORT=13000
DEVFLOW_OTLP_PORT=4317
DEVFLOW_OTLP_HTTP_PORT=4318
DEVFLOW_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.123.0
DEVFLOW_GRAFANA_IMAGE=grafana/grafana:11.6.0
DEVFLOW_LOKI_IMAGE=grafana/loki:3.4.2
DEVFLOW_TEMPO_IMAGE=grafana/tempo:2.7.2
DEVFLOW_PROMETHEUS_IMAGE=prom/prometheus:v3.2.1
