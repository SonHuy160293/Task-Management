# Literal, unquoted KEY=value only. No passwords, keys, or shell expansion here.
# scripts/devflow init copies this file; generated secrets are separate and stable.
DEVFLOW_STACK=devflow-local
DEVFLOW_ENVIRONMENT=Development
DEVFLOW_SECRETS_DIR=deploy/secrets/devflow-local
DEVFLOW_SETUP_IMAGE=devflow-setup:local
DEVFLOW_GATEWAY_IMAGE=devflow-gateway:local
DEVFLOW_GATEWAY_PORT=8080
DEVFLOW_GATEWAY_PUBLIC_HOST=localhost
DEVFLOW_HTTP_SUBNET=172.30.250.0/24
DEVFLOW_GATEWAY_IP=172.30.250.10
# Docker bridge peer used by a host-based ingress. Verify the observed peer for other topologies.
DEVFLOW_INGRESS_PROXY_IP=172.30.250.1
DEVFLOW_IDENTITY_API_IMAGE=devflow-identity-api:local
DEVFLOW_IDENTITY_WORKER_IMAGE=devflow-identity-worker:local
DEVFLOW_IDENTITY_MIGRATION_IMAGE=devflow-identity-migration:local
DEVFLOW_NOTIFICATION_API_IMAGE=devflow-notification-api:local
DEVFLOW_NOTIFICATION_WORKER_IMAGE=devflow-notification-worker:local
DEVFLOW_NOTIFICATION_MIGRATION_IMAGE=devflow-notification-migration:local
DEVFLOW_DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
DEVFLOW_DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0@sha256:de0ee358cdd672f7017a003bed21e9ac9ed48a27c922a59b18175b6e82fa7fee
DEVFLOW_POSTGRES_IMAGE=postgres:18-bookworm@sha256:bbf83594798e144bff365a9c191c5d779f181fb3135902064ab8ff11918020fc
DEVFLOW_REDIS_IMAGE=redis:7.4-alpine@sha256:57e4255cc971b1c8d6f8a6ca283ac01bc3ecdd914273ef6bfaede87aaecd6541
DEVFLOW_RABBITMQ_IMAGE=rabbitmq:4.3.6-management@sha256:54cb013d76cd1fd6c0a0708f34062ad61c452bb6f016b434c6c33f1a765d2b58
DEVFLOW_MAILPIT_IMAGE=axllent/mailpit:v1.27@sha256:e22dce5b36f93c77082e204a3942fb6b283b7896e057458400a4c88344c3df68
DEVFLOW_IDENTITY_API_PORT=8081
DEVFLOW_NOTIFICATION_API_PORT=8082
DEVFLOW_IDENTITY_POSTGRES_PORT=15431
DEVFLOW_NOTIFICATION_POSTGRES_PORT=15432
DEVFLOW_REDIS_PORT=16379
DEVFLOW_RABBITMQ_AMQP_PORT=5672
DEVFLOW_RABBITMQ_MANAGEMENT_PORT=15672
DEVFLOW_MAILPIT_SMTP_PORT=11025
DEVFLOW_MAILPIT_HTTP_PORT=18025
DEVFLOW_FRONTEND_ORIGIN=http://localhost:3000
DEVFLOW_JWT_ISSUER=DevFlow.Identity
DEVFLOW_JWT_AUDIENCE=DevFlow
DEVFLOW_MESSAGING_HOST=rabbitmq
DEVFLOW_MESSAGING_PORT=5672
DEVFLOW_MESSAGING_VIRTUAL_HOST=/devflow-local
DEVFLOW_MESSAGING_DEVELOPMENT=true
DEVFLOW_MESSAGING_USE_TLS=false
DEVFLOW_MESSAGING_QUORUM_SIZE=1
DEVFLOW_EMAIL_MODE=Mailpit
DEVFLOW_EMAIL_SENDER=DevFlow <auth@example.test>
DEVFLOW_EMAIL_DOMAIN_VERIFIED=false
DEVFLOW_GRAFANA_PORT=13000
DEVFLOW_OTLP_PORT=4317
DEVFLOW_OTLP_HTTP_PORT=4318
DEVFLOW_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.123.0
DEVFLOW_GRAFANA_IMAGE=grafana/grafana:11.6.0
DEVFLOW_LOKI_IMAGE=grafana/loki:3.4.2
DEVFLOW_TEMPO_IMAGE=grafana/tempo:2.7.2
DEVFLOW_PROMETHEUS_IMAGE=prom/prometheus:v3.2.1
