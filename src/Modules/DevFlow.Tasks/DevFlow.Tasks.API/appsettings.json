{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Observability": { "Enabled": false },
  "Integrations": {
    "Identity": {
      "BaseUrl": "https://identity.internal/",
      "ApiKeyHeaderName": "X-Integration-Api-Key",
      "Resilience": {
        "TotalRequestTimeout": { "Timeout": "00:00:08" },
        "AttemptTimeout": { "Timeout": "00:00:03" },
        "Retry": {
          "MaxRetryAttempts": 2,
          "Delay": "00:00:00.250",
          "BackoffType": "Exponential",
          "UseJitter": true,
          "ShouldRetryAfterHeader": true
        },
        "CircuitBreaker": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 20,
          "SamplingDuration": "00:00:30",
          "BreakDuration": "00:00:15"
        }
      }
    }
  }
}
