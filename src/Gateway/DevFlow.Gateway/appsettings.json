{
  "AllowedHosts": "localhost;127.0.0.1",
  "Gateway": { "RoutesFile": "proxy.json" },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ],
    "AllowedMethods": [ "POST" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-Correlation-ID", "traceparent", "tracestate" ],
    "ExposedHeaders": [ "X-Correlation-ID", "Retry-After" ],
    "AllowCredentials": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": { "Default": "Information", "Override": { "Yarp": "Fatal", "Microsoft.AspNetCore": "Fatal" } },
    "WriteTo": [ { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } } ]
  },
  "Observability": { "Enabled": false, "ServiceName": "DevFlow.Gateway" }
}
